# Package snapshot comparison file (internal use by sync-docs.sh)
.last-packages.txt

# Backup files created by bootstrap.sh
*.bak

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
*.swp
*.swo
*~

# Per-machine location for the eww weather/prayer widgets
config/eww/location.conf

# Python virtualenv + caches for eww scripts (recreated by bootstrap.sh)
config/eww/scripts/.venv/
__pycache__/
*.pyc

# Wallpapers (set them per machine with `<hostname> profile wallpaper`)
# and which profile is active
config/profiles/*/wallpapers/
config/profiles/.current
