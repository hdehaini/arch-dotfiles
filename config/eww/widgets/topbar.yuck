;; Eww Bar Configuration

(deflisten icon-theme
  :initial "light"
  `bash -c "cat ~/.config/eww//.icon-theme; inotifywait -e close_write ~/.config/eww//.icon-theme -m --format '' | while read; do cat ~/.config/eww//.icon-theme; done"`)

(deflisten ws_list
  :initial "[1,2,3]"
  "bash ~/.config/eww//scripts/get-dotfiles-config.sh")

(deflisten workspaces :initial "[]" 
  "bash ~/.config/eww//scripts/get-workspaces.sh")

(deflisten current-mode :initial "default"
  "~/.config/eww//scripts/i3-mode.sh")

;; Definisi variable untuk window title
(deflisten active_window
  "~/.config/eww//scripts/xwindow-clickable.sh")

;; Definisi variable untuk system variable
(deflisten system_status
  :initial '{"wifi_icon":"","wifi_desc":"","wifi_connected":false,"bat_icon":"","bat_desc":"","bat_capacity":0,"bat_charging":false,"bright_icon":"","bright_desc":"","bright_pct":0,"vol_icon":"","vol_desc":"","vol_pct":0,"vol_muted":false}'
  "python3 ~/.config/eww//scripts/system-monitor.py")

(defpoll pc_stats :interval "2s"
  :initial '{"cpu_usage":0,"cpu_temp":0,"mem_perc":0,"mem_used":"0G","mem_total":"0G","disk_perc":0,"disk_used":"0G","disk_total":"0G"}'
  "python3 ~/.config/eww//scripts/sys_info.py")

(defvar show_prayer_tooltip false)

;; Static or Poll variables
; (defpoll prayer_data :interval "300s"
;   :initial '{"city": "Loading...", "lat": "0.00° N", "long": "0.00° W", "next_name": "Fajr", "next_time": "00:00 AM", "next_icon": "", "daily": [{"name":"Fajr","icon":"","time":"00:00 AM"},{"name":"Dhuhr","icon":"","time":"00:00 AM"},{"name":"Asr","icon":"","time":"00:00 AM"},{"name":"Maghrib","icon":"","time":"00:00 AM"},{"name":"Isha","icon":"","time":"00:00 AM"}]}'
;   "~/.config/eww//scripts/.venv/bin/python ~/.config/eww//scripts/prayer_engine.py")

(deflisten prayer_data :initial '{"city": "Loading...", "lat": "0.00° N", "long": "0.00° W", "next_name": "Fajr", "next_time": "00:00 AM", "next_icon": "", "daily": [{"name":"Fajr","icon":"","time":"00:00 AM","is_next":false},{"name":"Dhuhr","icon":"","time":"00:00 AM","is_next":false},{"name":"Asr","icon":"","time":"00:00 AM","is_next":false},{"name":"Maghrib","icon":"","time":"00:00 AM","is_next":false},{"name":"Isha","icon":"","time":"00:00 AM","is_next":false}]}'
  "~/.config/eww//scripts/.venv/bin/python ~/.config/eww//scripts/prayer_process.py")


;; --------- WIDGET --------------------------------------------------

(defwidget mode-indicator []
  (box :class "mode-indicator"
       :valign "center"
       :vexpand false
       :visible {current-mode != "default"}
    (label :class "indicator-i3"
           :text "${current-mode}")))

(defwidget workspaces_widget []
  (box :class "i3-section"
       :spacing 2
       :valign "center"
       :vexpand false
    (for ws in {workspaces}
      (button
        :class "ws-btn ${ws.focused ? 'focused' : ''} ${ws.urgent ? 'urgent' : ''} ${ws.visible ? 'visible' : ''} ${ws.num <= 5 ? 'mon1' : (ws.num <= 10 ? 'mon2' : 'mon3')}"
        :onclick "if command -v hyprctl >/dev/null 2>&1; then hyprctl dispatch workspace ${ws.num}; else i3-msg 'workspace number ${ws.num}'; fi"
        "${ws.num}"))))

;; Main Bar Widget
(defwidget bar-widget []
  (centerbox :class "bar-container"
             :orientation "h"
             :valign "center"
             :vexpand false

    ;; ----------------------------------------------------------------
    ;; Bagian Kiri (start)
    ;; ----------------------------------------------------------------
    (box :class "bar-section-left"
         :orientation "h"
         :space-evenly false
         :halign "start"
         :spacing 10
         :valign "center"
         :vexpand false

      (eventbox :onclick "~/.config/eww//scripts/popup.sh toggle start_menu"
                :cursor "pointer"
        (label :class "start-menu-icon"
               :text " "))
        ; (image :path "${EWW_CONFIG_DIR}/assets/CachyOS-${icon-theme}.svg"
        ;        :image-width 20
        ;        :image-height 20))
        
      (workspaces_widget)

      (eventbox :onhover "eww -c $HOME/.config/eww/ update show_weather_tooltip=true && eww -c $HOME/.config/eww/ open weather-tooltip-window"
        :onhoverlost "eww -c $HOME/.config/eww/ update show_weather_tooltip=false && eww -c $HOME/.config/eww/ close weather-tooltip-window"
        (box :orientation "h" 
             :space-evenly false
             :spacing 10
          (label :class "weather-bar"
                 :text WEATHER_ICON)
          (label :class "text-weather-bar"
                 :text WEATHER_DESC)
        )
      )

      (eventbox :onclick "pkill -f mpv && eww -c $HOME/.config/eww/ close prayer-tooltip-window"
                :onhover "if [ \"$(eww -c $HOME/.config/eww/ active-windows | grep prayer-tooltip-window)\" = \"\" ]; then eww -c $HOME/.config/eww/ update show_prayer_tooltip=true && eww -c $HOME/.config/eww/ open prayer-tooltip-window; fi"
                :onhoverlost "eww -c $HOME/.config/eww/ update show_prayer_tooltip=false && eww -c $HOME/.config/eww/ close prayer-tooltip-window"
                :cursor "pointer"
        (box :orientation "h" 
             :space-evenly false
             :spacing 10
          (label :class "weather-bar"
                 :text "${prayer_data.next_icon}")
          (label :class "text-weather-bar"
                 :text "${prayer_data.next_name} ${prayer_data.next_time}")
        )
      )


      (mode-indicator)
    )
    
    ;; ----------------------------------------------------------------
    ;; Bagian Tengah (center) 
    ;; ----------------------------------------------------------------
    (box :class "bar-section-center"
         :orientation "h"
         :halign "center"
         :space-evenly false
         :valign "center"
         :vexpand false
      
      (eventbox :onclick "~/.config/eww//scripts/popup.sh toggle performance_monitor"
                :timeout "2s"
                :cursor "pointer"
        (box :class "windows-center-bar"
             :orientation "h"
             :halign "center"
             :space-evenly false
             :valign "center"
             :vexpand false
          (label :class "icon-center-bar"
                 :text " ")
          (label :class "center-text"
                 :text active_window)
        )
      )
    )    
    
    ;; ----------------------------------------------------------------
    ;; Bagian Kanan (end)
    ;; ----------------------------------------------------------------
    (box :class "bar-section-right"
         :orientation "h"
         :space-evenly false
         :halign "end"
         :spacing 5
         :valign "center"
         :vexpand false

      (box :class "system-tray-bar"
           :valign "center"
           :vexpand false
        (systray :icon-size 12
                 :spacing 8)
      )

            (box :class "status-section-right"
              :orientation "h"
              :space-evenly false
              :halign "end"
              :spacing 10
              :valign "center"
              :vexpand false

           ;; --- 2. PC Stats ---
           (box :orientation "h"
           :spacing 6
           :space-evenly false
             (label :class "right-icon"
               :text "")
             (label :class "right-text"
               :text "${pc_stats.cpu_usage}% ${pc_stats.cpu_temp}°C |")
           )
           (box :orientation "h"
           :spacing 6
           :space-evenly false
             (label :class "right-icon"
               :text " ")
             (label :class "right-text"
               :text "${pc_stats.mem_perc}%")
           )
            )

      (eventbox :onclick "~/.config/eww//scripts/popup.sh toggle notification_center"
                :cursor "pointer"
        (box :class "notification-section-right"
             :orientation "h"
             :space-evenly true
             :halign "end"
             :spacing 10
             :valign "center"
             :vexpand false
        (label :class "notification-icon"
               :text {(arraylength(notification_recent) + arraylength(notification_earlier)) > 0 ? "󰂚" : "󰂜"})))

       (eventbox :onclick "~/.config/eww//scripts/popup.sh toggle media_window"
                :cursor "pointer"
        (box :class "media-section"
             :orientation "h"
             :space-evenly true
             :halign "end"
             :spacing 10
             :valign "center"
             :vexpand false
          (label :class "media-icon"
                 :text {media_info.status == "Playing" ? "󰎈" : "󰎇"})))

      ;; --- 3. Brightness (own pill, sized like notification/media) ---
      (box :class "icon-pill"
           :halign "end"
           :valign "center"
           :vexpand false
        (label :class "right-icon"
               :xalign 0.5
               :text {system_status.bright_icon}))

      ;; --- 4. Volume (own pill) ---
      (box :class "icon-pill"
           :halign "end"
           :valign "center"
           :vexpand false
        (label :class "right-icon"
               :xalign 0.5
               :text {system_status.vol_icon}))

      ;; --- 4. Time (click → control center menu) ---
      (eventbox :onclick "~/.config/eww//scripts/toggle-control-center.sh & disown"
                :timeout "2s"
                :cursor "pointer"
        (box :class "time-bar"
             :orientation "h"
             :space-evenly false
             :spacing 6
             :valign "center"
             :vexpand false
          (label :class "time-icon"
                 :text " ")
          (label :class "time-text"
                 :valign "center"
                 :vexpand false
                 :width 78
                 :xalign 0.5
                 :text {datetime.time})
        )
      )

    )
  )
)

;; Window Definition
(defwindow bar
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "6px"
                      :width "100%"
                      :height "30px"
                      :anchor "top center")
  :stacking "bg"
  :exclusive true
  :focusable false
  :windowtype "dock"
  :wm-ignore true
  (bar-widget))
