;;-----------------------------------------------------
;; CLICKAWAY OVERLAY
;;-----------------------------------------------------

(defwidget clickaway []
  (eventbox :class "clickaway-overlay"
            :onclick "~/.config/eww//scripts/popup.sh close-all"
    (box :hexpand true :vexpand true)))

(defwindow clickaway
  :monitor 0
  :geometry (geometry :x "0%" :y "0%" :width "100%" :height "100%" :anchor "top left")
  :stacking "fg"
  :exclusive false
  :focusable "none"
  :windowtype "dialog"
  :wm-ignore false
  (clickaway))
