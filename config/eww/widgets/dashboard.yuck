;-------------------------------------------------------
; SYSTEM MONITOR WITH TABS - UPDATED VERSION
;-------------------------------------------------------
(defvar performance_monitor_visible false)

;; Variable active tab
(defvar active_tab "dashboard")

;; ===== POLLING VARIABLES =====

(deflisten datetime
  :initial `date '+{"time":"%H:%M","hour":"%H","hour12":"%-I","ampm":"%p","minute":"%M","month":"%B","month_short":"%b","year":"%Y","day":"%d","day_name":"%A","day_short":"%a"}'`
  "bash ~/.config/eww//scripts/datetime-listen.sh")

;; Profile polls
(defpoll profile 
  :interval "60s"
  :run-while performance_monitor_visible
  :initial '{"username": "loading...", "wm": "loading...", "uptime": "...", "image": ""}'
  "~/.config/eww//scripts/profile.sh json")

;; Weather polls
(defpoll WEATHER_CITY :interval "86400s" "~/.config/eww//scripts/weather-wrapper.sh city")
(defpoll WEATHER_TEMP :interval "86400s" "~/.config/eww//scripts/weather_wrapper_forecast.sh day0 max")
(defpoll WEATHER_LAT :interval "86400s" "~/.config/eww//scripts/weather-wrapper.sh lat")
(defpoll WEATHER_LONG :interval "86400s" "~/.config/eww//scripts/weather-wrapper.sh long")
(defpoll weather_forecast_data :interval "1h"
  :initial "[]"
  "~/.config/eww//scripts/weather_wrapper_forecast.sh json")

;; Seconds for the dashboard clock — only ticks while the panel is open.
(defpoll clock_second
  :interval "1s"
  :run-while performance_monitor_visible
  :initial "00"
  "date +%S")

;; Variables info laptop
(defpoll laptop_info :interval "86400s" 
  :initial '{"brand":"Loading...","model":"Loading...","cpu":"...","gpu":"...","ram":"...","disk":"...","logo_path":""}'
  "~/.config/eww//scripts/get-laptop-info.sh")

;;---------------- WIDGET ---------------------

;; Tab Navigation Widget
(defwidget tab_navigation []
  (box :class "tab-navigation"
       :orientation "h"
       :vexpand false
       :space-evenly true
       :spacing 0
    
    ;; Tab Performance
    (eventbox :onclick "eww -c $HOME/.config/eww/ update active_tab=performance"
              :cursor "pointer"
      (box :orientation "v"
           :spacing 0
           :space-evenly false
           :halign "center"
           :vexpand false
           :class "tab-button ${active_tab == 'performance' ? 'active' : ''}"
          
        (label :class "tab-icon" :text "󰒓")
        (label :class "tab-label" :text "Performance")

      )
    )
    
    ;; Tab Dashboard
    (eventbox :onclick "eww -c $HOME/.config/eww/ update active_tab=dashboard"
              :cursor "pointer"
      (box :orientation "v"
           :spacing 0
           :space-evenly false
           :vexpand false
           :halign "center"
           :class "tab-button ${active_tab == 'dashboard' ? 'active' : ''}"
        
        (label :class "tab-icon" :text "󰕮")
        (label :class "tab-label" :text "Dashboard")
      )
    )

    ;; Tab Information
    (eventbox :onclick "eww -c $HOME/.config/eww/ update active_tab=information"
            :cursor "pointer"
      (box :orientation "v"
           :spacing 0
           :space-evenly false
           :halign "center"
           :vexpand false
           :class "tab-button ${active_tab == 'information' ? 'active' : ''}"

        (label :class "tab-icon" :text "󰀉")
        (label :class "tab-label" :text "Information")
      )
    ) 
  )
)

;; Hardware card: icon, name, big number, a usage bar, and a detail line.
;; level is "" / "warm" / "hot" and colors the number and the bar.
(defwidget hw_card [icon label sub pct big detail color level]
  (box :class "hw-card"
       :orientation "v"
       :space-evenly false
       :spacing 8
       :hexpand true
    (box :orientation "h"
         :space-evenly false
         :spacing 12
      (label :class "hw-card-icon ${color}" :text icon :valign "center")
      (box :orientation "v"
           :space-evenly false
           :hexpand true
           :valign "center"
        (label :class "hw-card-label" :text label :xalign 0)
        (label :class "hw-card-sub" :text sub :xalign 0 :limit-width 28 :visible {sub != ""}))
      (label :class "hw-card-value ${level}" :text big :valign "center"))
    (progress :class "hw-card-bar ${color} ${level}"
              :value {pct == "" ? 0 : pct}
              :orientation "h")
    (label :class "hw-card-detail" :text detail :xalign 0)))

;;Profile Widget
(defwidget profile_widget []
  (box :class "info-card"
       :orientation "h"  
       :space-evenly false
       :spacing 12
       :valign "center"
       :hexpand true
    
    ;; Profile Image
    ;; Akses via profile.image
    (box :class "profile-pic"
         :style "background-image: url('${profile-pic}');
                 background-size: cover;
                 background-position: center;
                 border-radius: 10px;
                 min-width: 75px;
                 min-height: 75px;")
    
    ;; Profile Info
    (box :class "card-content"
         :orientation "v"
         :space-evenly false
         :valign "center"
         :vexpand false
         :spacing 0
      
      ;; Username
      ;; Akses via profile.username
      (box :class "info-row"
           :orientation "h" :space-evenly false :spacing 6
        (label :class "info-icon" :text "")
        (label :class "info-text" :limit-width 13 :text {profile.username} :xalign 0)
      )
      
      ;; Window Manager
      ;; Akses via profile.wm
      (box :class "info-row"
           :orientation "h" :space-evenly false :spacing 6
        (label :class "info-icon" :text "")
        (label :class "info-text" :text {profile.wm} :xalign 0)
      )
      
      ;; Uptime
      ;; Akses via profile.uptime
      (box :class "info-row"
           :orientation "h" :space-evenly false :spacing 6
        (label :class "info-icon" :text "")
        (label :class "info-text" :limit-width 13 :text {profile.uptime} :xalign 0)
      )
    )
  )
)

;; Weather Widget
(defwidget weather_widget []
  (box :class "info-card-weather"
       :orientation "h"
       :space-evenly false
       :hexpand true
    
    (box :class "info-row-weather"
         :orientation "h"
         :spacing 0
         :width 100
      (label :class "weather-icon" :text {weather_now.icon}))
    
     ;; Weather info 
    (box :class "card-content"
         :orientation "v"
         :space-evenly false
         :spacing 5
         :valign "center"  
      
      (label :class "info-weather" :limit-width 9 :wrap true :wrap-mode "wordchar" :lines 2 :justify "center" :text WEATHER_CITY :xalign 0.5)
      (label :class "info-text" :limit-width 16 :wrap true :wrap-mode "wordchar" :lines 2 :justify "center" :text "${weather_now.temp} ${weather_now.desc}" :xalign 0.5))
))

(defwidget calendar_box []
    (box :class "calendar-box"
         :orientation "v"
         :space-evenly false

    ;; Header manual
    (box :class "cal-header"
         :orientation "h"
         :halign "center"
         :space-evenly false
         :spacing 10 

      (label :class "cal-month" :text {datetime.month})
      (label :class "cal-year"  :text {datetime.year}))

    (calendar :class "cal-widget"
              :show-heading false
              :halign "center"
              :vexpand false)))

;; Clock & Date Widget: HH:MM:SS on one line, date under it
(defwidget clock_box []
  (box :class "clock-box"
       :orientation "v"
       :space-evenly false
       :spacing 2
       :hexpand true
    (box :orientation "h"
         :halign "center"
         :space-evenly false
         :spacing 4
      (label :class "clock-time" :text {datetime.hour12})
      (label :class "clock-separator" :text ":")
      (label :class "clock-time" :text {datetime.minute})
      (label :class "clock-separator" :text ":")
      (label :class "clock-time clock-seconds" :text clock_second)
      (label :class "clock-ampm" :valign "end" :text {datetime.ampm}))
    (label :class "clock-date"
           :halign "center"
           :text "${datetime.day_name}, ${datetime.month} ${datetime.day}")))

;; WIDGET MEDIA PLAYER
(defwidget media_widget_dashboard []
  (box :class "media-widget-dashboard"
       :orientation "v"
       :space-evenly false
       :vexpand true
       :spacing 10
    (box :vexpand true)   ;; centers the card's content in the full height

    ;; Cover Art
    (box :style {media_info.cover != "" ? 
       "background-image: url('${media_info.cover}'); 
       background-size: cover; 
       background-position: center; 
       border-radius: 10px; 
       min-width: 75px; 
       min-height: 75px;" : 
       
       "background-image: none; 
       border-radius: 10px; 
       min-width: 75px; 
       min-height: 75px;"})
    
    ;; Media Info
    (box :class "media-widget-info-dashboard"
         :orientation "v"  
         :space-evenly false
         :spacing 5
      
      ;; Label section
      (box :orientation "v"
           :space-evenly false
           :hexpand true
           :halign "center"
        (label :class "media-widget-name-dashboard"
               :text {media_info.player}
               :limit-width 13
               :visible {media_info.player != ""}
               :xalign 0.5)
        (label :class "media-widget-title-dashboard"
               :text {media_info.title}
               :limit-width 13
               :xalign 0.5)
        (label :class "media-widget-artist-dashboard"
               :text {media_info.artist}
               :limit-width 15
               :xalign 0.5))
      
      ;; Controls
      (box :class "media-widget-controls-dashboard" :halign "center" :spacing 10
        (eventbox :onclick "playerctl -p ${media_info.player} previous"
          (box :width 30 :height 30 :halign "center" :valign "center"
            (label :text "󰒮" :class "media-widget-btn-dashboard")))
        
        (eventbox :onclick "playerctl -p ${media_info.player} play-pause"
          (box :width 30 :height 30 :halign "center" :valign "center"
            (label :text {media_info.status == "Playing" ? "󰏤" : "󰐊"}
                   :class "media-widget-btn-play-dashboard")))
        
        (eventbox :onclick "playerctl -p ${media_info.player} next"
          (box :width 30 :height 30 :halign "center" :valign "center"
            (label :text "󰒭" :class "media-widget-btn-dashboard"))))
      )
    (box :vexpand true)))

;; Performance tab: hardware health (also opened by clicking the bar's
;; CPU/GPU/RAM stats). Warm/hot thresholds match the bar.
(defwidget performance_content []
  (box :class "tab-content hw-grid"
       :orientation "v"
       :spacing 10
       :space-evenly false
    (box :orientation "h"
         :spacing 10
         :space-evenly true
      (hw_card :icon ""
               :label "Processor"
               :sub {pc_stats.cpu_name ?: ""}
               :pct {pc_stats.cpu_usage}
               :big "${pc_stats.cpu_usage}%"
               :detail "Temperature ${pc_stats.cpu_temp}°C"
               :color "cpu-color"
               :level {pc_stats.cpu_temp >= 85 ? "hot" : pc_stats.cpu_temp >= 75 ? "warm" : ""})
      (box :visible {pc_stats.gpu_present ?: false}
        (hw_card :icon "󰢮"
                 :label "Graphics"
                 :sub {pc_stats.gpu_name ?: ""}
                 :pct {pc_stats.gpu_usage ?: 0}
                 :big "${pc_stats.gpu_usage ?: '–'}%"
                 :detail "Temperature ${pc_stats.gpu_temp ?: '–'}°C · VRAM ${pc_stats.gpu_vram_used} / ${pc_stats.gpu_vram_total}"
                 :color "gpu-color"
                 :level {(pc_stats.gpu_temp ?: 0) >= 90 ? "hot" : (pc_stats.gpu_temp ?: 0) >= 80 ? "warm" : ""})))
    (box :orientation "h"
         :spacing 10
         :space-evenly true
      (hw_card :icon ""
               :label "Memory"
               :sub "RAM"
               :pct {pc_stats.mem_perc}
               :big "${pc_stats.mem_perc}%"
               :detail "${pc_stats.mem_used} of ${pc_stats.mem_total} in use"
               :color "mem-color"
               :level {pc_stats.mem_perc >= 90 ? "hot" : pc_stats.mem_perc >= 80 ? "warm" : ""})
      (hw_card :icon ""
               :label "Disk"
               :sub "System drive (/)"
               :pct {pc_stats.disk_perc}
               :big "${pc_stats.disk_perc}%"
               :detail "${pc_stats.disk_used} of ${pc_stats.disk_total} used"
               :color "disk-color"
               :level {pc_stats.disk_perc >= 90 ? "hot" : pc_stats.disk_perc >= 80 ? "warm" : ""}))))

;; Widget box utama
(defwidget laptop-info-widget []
  (box :class "laptop-container"
       :orientation "h"
       :space-evenly false
       :spacing 10
    
    ;; Logo laptop dari cache
  (box :class "logo-section"
         :halign "center"
      (image :path {laptop_info.logo_path}
             :image-width 50
             :image-height 50
             :visible {laptop_info.logo_path != ""}))
    
    ;; Info spesifikasi
    (box :class "specs-section"
         :orientation "v"
         :space-evenly false
         :spacing 0
      
      ;; Brand & Model
      (box :class "brand-row"
           :space-evenly false
           :spacing 10
           :orientation "h"
        (label :class "spec-brand" :text "${laptop_info.model}"))
      
      ;; CPU
      (box :class "spec-row"
           :space-evenly false
           :spacing 10
        (box :orientation "h" :space-evenly false :spacing 10
          (label :class "spec-label" :width 70 :text "CPU" :xalign 0)
          (label :class "spec-value" :text "${laptop_info.cpu}" :halign "start")))
      
      ;; GPU
      (box :class "spec-row"
           :space-evenly false
           :spacing 10
        (box :orientation "h" 
             :space-evenly false
             :spacing 10
             :width 300
          (label :class "spec-label" :text "GPU" :width 70 :xalign 0)
          (label :class "spec-value" 
                 :text "${laptop_info.gpu}" 
                 :wrap true 
                 :limit-width 35
                 :lines 2
                 :justify "left" 
                 :halign "start")))
      
      ;; RAM
      (box :class "spec-row"
           :space-evenly false
           :spacing 0
       (box :orientation "h" :space-evenly false :spacing 10
          (label :class "spec-label" :text "Memory" :width 70 :xalign 0)
          (label :class "spec-value" :text "${laptop_info.ram}" :halign "start")))
      
      ;; Disk
      (box :class "spec-row"
           :space-evenly false
           :spacing 0
        (box :orientation "h" :space-evenly false :spacing 10
          (label :class "spec-label" :text "Storage" :width 70 :xalign 0)
          (label :class "spec-value" :text "${laptop_info.disk}" :halign "start"))))))
          
;; Dashboard Separator          
(defwidget dashboard_separator []
  (box :class "dashboard_separator" :hexpand true))

;; Dashboard Content Widget 
;; Dashboard tab: profile + weather across the top; clock and calendar
;; on the left below, media next to them at the same height.
(defwidget dashboard_content []
  (box :class "tab-content"
       :orientation "v"
       :space-evenly false
       :spacing 10

    ;; Row 1: profile and weather, sharing the full width
    (box :class "column"
         :orientation "h"
         :spacing 10
         :space-evenly true
      (profile_widget)
      (weather_widget))

    ;; Row 2: clock over the calendar | media
    (box :orientation "h"
         :spacing 10
         :space-evenly false
      (box :class "column"
           :orientation "v"
           :spacing 10
           :hexpand true
           :space-evenly false
        (clock_box)
        (calendar_box))
      ;; media: a narrow column (about a quarter of the panel)
      (box :class "right-column"
           :orientation "v"
           :width 120
           :space-evenly false
        (media_widget_dashboard)))))

;; Main Widget
(defwidget main_widget []
  (box :class "main-container"
       :orientation "v"
       :space-evenly false
    
    ;; Tab Navigation (Tombol Atas)
    (tab_navigation)

    (dashboard_separator)
    
    ;; Kita mapping logic: dashboard=0, performance=1, information=2
    (box :class "content-area"
      (stack :selected {active_tab == "dashboard" ? 0 : active_tab == "performance" ? 1 : 2}
             :transition "none"   ;; instant (eww can't shorten the fade)
        
        ;; Index 0: Dashboard Content
        (dashboard_content)
        
        ;; Index 1: Performance Content
        (performance_content)

        ;; Index 2: Information Content
        (laptop-info-widget)
      )
    )
  )
)

;; ----------------------------------------
;; JENDELA UTAMA 
;; ----------------------------------------
(defwindow performance_monitor
  :monitor 0
  :geometry (geometry :x "0%"
                      :y "10px"
                      :width "200px"
                      :height "100px"
                      :anchor "top center")
  :stacking "overlay"
  :exclusive false
  :windowtype "dialog"
  :wm-ignore false
  :focusable false
  :resizable false
  (main_widget))
